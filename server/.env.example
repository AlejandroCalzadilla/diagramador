PORT=3000
NODE_ENV=development

# Database Configuration (Neon / Cloud PostgreSQL)
# Example: postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Fallback Local Database Configuration (Used if DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=chartdb
DATABASE_PASSWORD=chartdb_password
DATABASE_NAME=chartdb
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Authentication
JWT_SECRET=super_secret_chartdb_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*
